# Copy to .env and adjust.
# "embedded" keeps a private Postgres in .pgdata/ (no Docker needed).
DATABASE_URL=embedded
# With Docker (`docker compose up -d`) use this instead:
# DATABASE_URL=postgresql://nse:nse@localhost:5432/nse
# Identify yourself to the sites you fetch from.
HTTP_USER_AGENT=nse-agent/0.1 (personal project; you@example.com)
HTTP_TIMEOUT=30
AFX_BASE_URL=https://afx.kwayisi.org/nse/
# Flag price snapshots older than this many calendar days.
STALE_AFTER_DAYS=5
# FEEDS_PATH=/path/to/your/feeds.json
# Trading costs — set to your broker's actual rate (1.0-1.5% typical).
BROKERAGE_PCT=1.5
BROKERAGE_MIN=0
DIVIDEND_WHT_PCT=5
# Below this much long-term money, the plan skips a separate T-bill bucket.
GOVT_SECURITIES_MIN=100000
